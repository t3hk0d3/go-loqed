# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
# Precedence: LOQED_* env > YAML (--config) > options.json. Nested keys use "__".

# --- LOQED cloud (one of the two) ---
LOQED_CLOUD_TOKEN=
# LOQED_CLOUD_EMAIL=
# LOQED_CLOUD_PASSWORD=
# Max cloud API calls per 12 h (1-12; LOQED blocks above 12).
# LOQED_CLOUD_BUDGET=10
# LOQED_CACHE_MAX_AGE=24h

# --- MQTT broker ---
LOQED_MQTT__URL=tcp://127.0.0.1:1883
LOQED_MQTT__USERNAME=
LOQED_MQTT__PASSWORD=
# LOQED_MQTT__BASE_TOPIC=loqed

# --- Home Assistant discovery ---
# LOQED_HOMEASSISTANT__ENABLED=true

# --- Webhook receiver (bridge -> gateway) ---
# LOQED_WEBHOOK__LISTEN=:8099
# URL the bridge can reach when the gateway runs behind NAT / in a container:
# LOQED_WEBHOOK__PRIVATE_URL=http://192.168.1.10:8099
